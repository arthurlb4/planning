{
  "name": "lecteur-iptv",
  "productName": "Lecteur IPTV",
  "version": "1.0.0",
  "description": "Lecteur IPTV (listes M3U et Xtream) pour Windows",
  "author": "franceinfo planning",
  "main": "main.js",
  "private": true,
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.franceinfoplanning.iptv",
    "productName": "Lecteur IPTV",
    "files": ["main.js", "index.html", "icon.png"],
    "win": {
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "artifactName": "Lecteur-IPTV.exe",
      "icon": "icon.png"
    }
  }
}
