{
  "name": "lecteur-iptv",
  "productName": "Lecteur IPTV",
  "version": "1.2.0",
  "description": "Lecteur IPTV (listes M3U et Xtream) pour Windows",
  "author": "franceinfo planning",
  "main": "main.js",
  "private": true,
  "dependencies": {
    "ffmpeg-static": "5.2.0"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.franceinfoplanning.iptv",
    "productName": "Lecteur IPTV",
    "files": ["main.js", "preload.js", "remux.js", "index.html", "icon.png", "icon.ico", "node_modules/ffmpeg-static/**/*"],
    "asarUnpack": ["node_modules/ffmpeg-static/**/*"],
    "win": {
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "artifactName": "Lecteur-IPTV.exe",
      "icon": "icon.ico"
    }
  }
}
