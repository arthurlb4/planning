{
  "name": "lecteur-iptv",
  "productName": "Lecteur IPTV",
  "version": "1.19.0",
  "description": "Lecteur IPTV (listes M3U et Xtream) pour Windows",
  "author": "franceinfo planning",
  "main": "main.js",
  "private": true,
  "dependencies": {
    "ffmpeg-static": "5.2.0",
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.franceinfoplanning.iptv",
    "productName": "Lecteur IPTV",
    "files": [
      "**/*",
      "!dist{,/**/*}",
      "!**/*.md",
      "!index.html.bak"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Lecteur-IPTV-Installation.exe",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lecteur IPTV",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/arthurlb4/planning/releases/download/iptv-desktop/"
      }
    ]
  }
}
