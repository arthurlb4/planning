<?xml version="1.0" encoding="UTF-8"?>
<!-- Lecteur IPTV pour téléviseur Samsung (Tizen 6 et plus récent). Charge la version télé du lecteur depuis le site
     (toujours à jour) ; sans réseau vers le site, la copie livrée dans le paquet (tv.html). -->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="https://franceinfoplanning.com/iptv/tv" version="1.0.0" viewmodes="maximized">
    <tizen:application id="LectIPTVfr.LecteurIPTV" package="LectIPTVfr" required_version="6.0"/>
    <content src="index.html"/>
    <icon src="icon.png"/>
    <name>Lecteur IPTV</name>
    <access origin="*" subdomains="true"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:profile name="tv-samsung"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
