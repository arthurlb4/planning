<Project Sdk="Microsoft.NET.Sdk">
  <!-- Lecteur IPTV, version native : une seule fenêtre où Windows assemble la page (WebView2, moteur d'Edge) et la vidéo
       (mpv, même moteur que VLC) dessinée juste dessous. Voir LISEZMOI.md -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LecteurIPTV</AssemblyName>
    <RootNamespace>LecteurNatif</RootNamespace>
    <ApplicationIcon>..\desktop\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <EmbeddedResource Include="shim.js" LogicalName="shim.js" />
  </ItemGroup>
</Project>
